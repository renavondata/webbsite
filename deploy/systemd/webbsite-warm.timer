# Every 10 minutes: a page that is already current costs a file read, so this
# is cheap when nothing changed, and it bounds how long any cold variant can
# wait (after a deploy, the midnight date roll, or a wiped cache) to ~10 min.
# The refresh loader also starts the service directly on success.
[Unit]
Description=Webb-site precompute warming every 10 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
