# Captured from the live droplet webbsite-web (/etc/caddy/Caddyfile). Source of truth,
# and since 2026-09 enforced as such: deploy/converge.sh installs this file on every
# deploy tick, so an edit here reaches the box and a hand-edit on the box is reverted.
# Terminates TLS on :443 and reverse-proxies to gunicorn on 127.0.0.1:8000.
# Uses `tls internal` (Caddy self-signed CA): the renavon.com Cloudflare zone runs SSL mode
# "Full" (not strict), so CF encrypts to the origin without validating the cert — consistent
# with the other renavon subdomains. UFW restricts :443 to Cloudflare IP ranges, so the origin
# is not directly reachable. If the zone is ever switched to "Full (strict)", replace
# `tls internal` with a Cloudflare Origin CA cert (tls /etc/caddy/origin.crt /etc/caddy/origin.key).
{
	# Not `admin off`. The admin endpoint is what `systemctl reload caddy` talks
	# to; with it disabled the reload fails and the only way to apply a new
	# Caddyfile is a full restart, which drops every in-flight TLS connection.
	# Loopback only, so nothing but this box can reach it. (Same reasoning as
	# the renavon fleet's base Caddyfile.) Also exposes /metrics for a future
	# scraper.
	admin localhost:2019
}

webbsite.renavon.com {
	# gzip only. Cloudflare offers the origin `Accept-Encoding: gzip, br` and never
	# zstd (verified against the request headers in the 2026-09-11 journal), so a
	# zstd encoder was configuration that could never fire. This is the ONLY
	# compressor: the app's Flask-Compress was removed in 2026-09 so a worker
	# thread no longer spends CPU on level-6 gzip that the proxy does anyway.
	encode gzip

	# Proxy + access log come from site-deploy's reference block
	# (host/caddy/reverse-proxy.caddy, gfrmin/site-deploy#25): a JSON access log
	# at /var/log/caddy/webbsite.access.log (5 x 100 MB), dial_timeout 5s,
	# response_header_timeout 65s, and a cap of N requests in flight. Imported,
	# not copied, so a fix to it reaches every site. Its header explains each line.
	#
	# N = 48: gunicorn serves 24 at once (3 workers x 8 threads), times a queue
	# factor of 2, so a burst waits at most about one request's service time.
	# Request N+1 gets an immediate 503 instead of queueing. That is the shed the
	# 2026-09-26 crawl needed: 125k requests queued behind a saturated gunicorn
	# until they failed as 502/504, the probe with them. The cap is soft (a
	# simultaneous burst overshoots it slightly), so it is sized with margin.
	#
	# The two request headers are set here rather than as header_up, because the
	# reverse_proxy block lives in the import. request_header runs before
	# reverse_proxy and the proxy forwards request headers, so the app sees the
	# same values:
	# - X-Request-Id: one id per request, minted here and echoed by the app in
	#   its response and access log, so a journal line, this log, a Sentry event
	#   and a user's report can be joined on it. Cloudflare's CF-Ray is kept too.
	# - X-Real-IP: the real client, not Cloudflare's edge; the app and its logs
	#   read this.
	request_header X-Request-Id {http.request.uuid}
	request_header X-Real-IP {http.request.header.Cf-Connecting-Ip}
	import /srv/site-deploy/host/caddy/reverse-proxy.caddy webbsite 127.0.0.1:8000 48

	tls internal
}
